{
  "name": "campertunity-ai-tools",
  "version": "0.1.0",
  "description": "AI tools for Campertunity - MCP server, skill files, and backend interfaces for campground search and booking",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "campertunity-ai-tools": "dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "campertunity",
    "camping",
    "outdoor",
    "recreation",
    "ai",
    "model-context-protocol",
    "skills",
    "openclaw",
    "agent-tools"
  ],
